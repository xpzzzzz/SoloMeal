# Copy to backend/.env. Use a dedicated database; migrations never create it.
SOLOMEAL_DATABASE_URL=mysql+pymysql://solomeal:CHANGE_ME@127.0.0.1:3306/solomeal?charset=utf8mb4
SOLOMEAL_SESSION_TTL_SECONDS=86400

# Agent is opt-in; never commit real credentials.
SOLOMEAL_AGENT_ENABLED=false
SOLOMEAL_MODEL_BASE_URL=https://api.openai.com/v1
SOLOMEAL_MODEL_NAME=
# Native tool calling remains default; optional strict JSON envelope compatibility mode.
SOLOMEAL_MODEL_TOOL_PROTOCOL=native
# Chat output budget only; 1..3000, default 1500. Request timeout remains 30 seconds.
SOLOMEAL_MODEL_MAX_COMPLETION_TOKENS=1500
# Optional chat-only provider extension; omit unless supported by the selected provider.
# SOLOMEAL_MODEL_ENABLE_THINKING=false
# SOLOMEAL_MODEL_API_KEY=

# Optional absolute private upload directory; default backend/private_uploads.
# SOLOMEAL_RECEIPT_STORAGE_DIR=
SOLOMEAL_RECEIPT_PARSER_TIMEOUT_SECONDS=30
# Explicitly enable sending receipt images to the configured model provider.
SOLOMEAL_RECEIPT_VISION_ENABLED=false
SOLOMEAL_RECEIPT_PARSE_DAILY_LIMIT=10
# Optional provider extension (e.g. Qwen hybrid thinking). Omit for other providers.
# SOLOMEAL_RECEIPT_MODEL_ENABLE_THINKING=false
