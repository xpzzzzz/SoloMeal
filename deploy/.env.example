# Generate private values with: python deploy/manage.py init --env-file /private/solomeal.env
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
DB_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX
BIND_ADDRESS=127.0.0.1
HTTP_PORT=18080
IMAGE_TAG=local
SOLOMEAL_AGENT_ENABLED=false
SOLOMEAL_RECEIPT_VISION_ENABLED=false
# Optional model credentials remain local; do not commit this file with secrets.
# SOLOMEAL_MODEL_BASE_URL=https://api.openai.com/v1
# SOLOMEAL_MODEL_NAME=
# SOLOMEAL_MODEL_API_KEY=
# SOLOMEAL_MODEL_TOOL_PROTOCOL=json
# omit excludes the provider extension; true/false are independent. Blank is invalid.
SOLOMEAL_MODEL_ENABLE_THINKING=omit
SOLOMEAL_MODEL_MAX_COMPLETION_TOKENS=1500
SOLOMEAL_RECEIPT_MODEL_ENABLE_THINKING=omit
SOLOMEAL_RECEIPT_PARSE_DAILY_LIMIT=10
SOLOMEAL_RECEIPT_PARSER_TIMEOUT_SECONDS=30
